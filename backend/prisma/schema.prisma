generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent, pgcrypto]
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      String   @default("free")
  currency  String   @default("VND") @db.Char(3)
  timezone  String   @default("Asia/Ho_Chi_Minh")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users     User[]
  auditLogs AuditLog[]
  contacts  Contact[]
  pipelines Pipeline[]
  deals     Deal[]
  stages    Stage[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(SALES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  contacts      Contact[]      @relation("ContactOwner")
  deals         Deal[]         @relation("DealOwner")

  @@unique([orgId, id])
  @@index([orgId, role, active])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?   @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replacements RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  orgId     String   @map("org_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  entity    String
  entityId  String   @map("entity_id")
  action    String
  before    Json?
  after     Json?
  requestId String?  @map("request_id")
  ip        String?  @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [orgId, actorId], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, entity, entityId, createdAt(sort: Desc)])
  @@index([orgId, actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Contact {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  company   String?
  source    String?
  ownerId   String?   @map("owner_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner        User?        @relation("ContactOwner", fields: [orgId, ownerId], references: [orgId, id], onDelete: Restrict, onUpdate: Cascade)
  deals        Deal[]

  @@unique([orgId, id])
  @@index([orgId, ownerId])
  @@index([orgId, deletedAt])
  @@map("contacts")
}

model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stages       Stage[]
  deals        Deal[]

  @@unique([orgId, id])
  @@map("pipelines")
}

model Stage {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  name       String
  position   Decimal  @db.Decimal(20, 10)
  isWon      Boolean  @default(false) @map("is_won")
  isLost     Boolean  @default(false) @map("is_lost")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pipeline     Pipeline     @relation(fields: [orgId, pipelineId], references: [orgId, id], onDelete: Cascade, onUpdate: Cascade)
  deals        Deal[]

  @@unique([orgId, pipelineId, id])
  @@unique([orgId, id])
  @@index([orgId, pipelineId, position])
  @@map("stages")
}

model Deal {
  id            String     @id @default(uuid()) @db.Uuid
  orgId         String     @map("org_id") @db.Uuid
  contactId     String     @map("contact_id") @db.Uuid
  pipelineId    String     @map("pipeline_id") @db.Uuid
  stageId       String     @map("stage_id") @db.Uuid
  title         String
  value         Decimal    @default(0) @db.Decimal(14, 2)
  currency      String     @db.Char(3)
  ownerId       String     @map("owner_id") @db.Uuid
  expectedClose DateTime?  @map("expected_close") @db.Date
  status        DealStatus @default(OPEN)
  lostReason    String?    @map("lost_reason")
  position      Decimal    @db.Decimal(20, 10)
  version       Int        @default(1)
  closedAt      DateTime?  @map("closed_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contact      Contact      @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Restrict, onUpdate: Cascade)
  pipeline     Pipeline     @relation(fields: [orgId, pipelineId], references: [orgId, id], onDelete: Restrict, onUpdate: Cascade)
  stage        Stage        @relation(fields: [orgId, pipelineId, stageId], references: [orgId, pipelineId, id], onDelete: Restrict, onUpdate: Cascade)
  owner        User         @relation("DealOwner", fields: [orgId, ownerId], references: [orgId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([orgId, id])
  @@index([orgId, stageId, position, id])
  @@index([orgId, ownerId])
  @@index([orgId, status, closedAt])
  @@index([orgId, expectedClose])
  @@index([orgId, contactId])
  @@map("deals")
}
