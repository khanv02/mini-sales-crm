{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node scripts/run-with-env.mjs pnpm exec tsx prisma/seed.ts"
  },
  "scripts": {
    "predev": "pnpm --filter @pulse/shared build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @pulse/shared build",
    "build": "nest build",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm --filter @pulse/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test prisma/seed.ts --max-warnings=0",
    "pretest:unit": "pnpm --filter @pulse/shared build",
    "test:unit": "jest --config test/jest-unit.config.ts",
    "test:unit:cov": "jest --config test/jest-unit.config.ts --coverage",
    "pretest:integration": "pnpm --filter @pulse/shared build",
    "test:integration": "jest --config test/jest-integration.config.ts --runInBand",
    "test": "pnpm test:unit && pnpm test:integration",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/run-with-env.mjs pnpm exec prisma migrate deploy",
    "db:migrate:dev": "node scripts/run-with-env.mjs pnpm exec prisma migrate dev",
    "db:seed": "node scripts/run-with-env.mjs pnpm exec tsx prisma/seed.ts",
    "db:reset": "node scripts/run-with-env.mjs pnpm exec prisma migrate reset --force",
    "db:studio": "node scripts/run-with-env.mjs pnpm exec prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/swagger": "^11.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.3.1",
    "@pulse/shared": "workspace:*",
    "@sentry/node": "^9.0.0",
    "bullmq": "^5.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/testing": "^11.0.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
