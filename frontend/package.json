{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @pulse/shared build",
    "dev": "vite",
    "prebuild": "pnpm --filter @pulse/shared build",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm --filter @pulse/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src e2e vite.config.ts --max-warnings=0",
    "pretest:unit": "pnpm --filter @pulse/shared build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pulse/shared": "workspace:*",
    "@sentry/react": "^9.0.0",
    "@tanstack/react-query": "^5.64.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
